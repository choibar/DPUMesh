# Host library configuration. Copy to .env and source it, or export the values.
# Every value is read from the environment; nothing is compiled in.

# --- Device (every host process) ---
DPUMESH_BROKER=/run/dpumesh/broker.sock       # dpu-dma: socket of dpumesh_broker, which owns the DOCA device
DPUMESH_PCI_ADDR=<host-pci-function>          # host-side PCI function of the DPU: dpumesh_broker's (--pci), or
                                              # the application's own on the in-process host-dpa path
DPUMESH_SERVER=DPUMesh0                       # Comch server name of the DPU worker
DPUMESH_POD_IP=<this-process-ipv4>            # source address of this process's flows
DPUMESH_WORKLOAD=                             # optional workload label carried in the flow
DPUMESH_POD_ID=0                              # value returned by dmesh_pod_id

# --- Server processes ---
DPUMESH_SERVICE=<host>:<port>                 # Service target this process serves (DNS name or IPv4); unset for clients
DPUMESH_PORT=<listen-port>                    # preload shim only: the socket port the server listens on
DPUMESH_BACKEND_POOL=8                        # spare inbound flows kept open
DPUMESH_BACKEND_MAX=16                        # spare + active inbound flows

# --- Preload clients ---
DPUMESH_TARGETS=<host>:<port>,...             # destinations the shim carries over DPUmesh; others use kernel TCP

# --- Go examples ---
DPUMESH_SERVICE_IP=<service-ipv4>             # address the Go clients dial; servers use DPUMESH_SERVICE
DPUMESH_SERVICE_PORT=<service-port>

# --- Reverse (DPU -> host) wire ---
# Deployment model on current firmware: DPUMESH_PCI_ADDR is the pod's own SF
# (Comch), DPUMESH_HOST_DPA_PCI is the node's host PF (every pod's DPA process lives
# there; its vhca needs the one DPA EU partition). See design/HOST.md.
DPUMESH_REVERSE=host-dpa                      # host-dpa (host-owned DPA thread per connection, still opened in this process)
                                              # | dpu-dma (the DPU's DMA engine writes into the host, no host DPA; the
                                              # broker owns the device, so pods need no PF access)
DPUMESH_HOST_DPA_PCI=<host-pf-pci-address>    # host-dpa only: the host PF whose DPA process runs the reverse threads, e.g. 0b:00.0
#DPUMESH_HOST_DPA_DEV=<sf-ibdev-name>         # host-dpa only, optional: extend that process to this SF (mlx5_N). Not usable per pod
                                              # on current firmware: one running SF blocks the others (design/HOST.md)

# --- Polling (optional) ---
DPUMESH_SPIN_US=1000                          # empty-poll window before an EQ arms its doorbells and sleeps (0 = arm at once)
DPUMESH_TICK_US=50                            # fallback poll period of a sleeping EQ while custody ACKs or push batches are outstanding
DPUMESH_CARRIER_TRACE=                        # set to trace flows and descriptors on stderr
DPUMESH_CORE_TRACE=                           # set to trace core events on stderr

# --- DPU proxy (DPUMesh linkerd2-proxy) values used with this library ---
LINKERD2_PROXY_DOCA_DEV_PCI_ADDR=<dpu-pci-function>
LINKERD2_PROXY_DOCA_REP_PCI_ADDR=<host-representor>
LINKERD2_PROXY_DOCA_SERVER_NAME=DPUMesh0
DMESH_NUM_WORKERS=1
DMESH_BUSY_POLL=1                             # required on this build; see design/HOST.md
