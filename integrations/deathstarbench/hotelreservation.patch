@@ -2,6 +2,7 @@ package dialer
 
 import (
 	"fmt"
+	"github.com/delimitrou/DeathStarBench/tree/master/hotelReservation/dmesh"
 	"time"
 
 	"github.com/delimitrou/DeathStarBench/tree/master/hotelReservation/tls"
@@ -34,6 +35,7 @@ func Dial(name string, opts ...DialOption) (*grpc.ClientConn, error) {
 
 	dialopts := []grpc.DialOption{
 		grpc.WithKeepaliveParams(keepalive.ClientParameters{
+			Time:                5 * time.Minute,
 			Timeout:             120 * time.Second,
 			PermitWithoutStream: true,
 		}),
@@ -52,10 +54,18 @@ func Dial(name string, opts ...DialOption) (*grpc.ClientConn, error) {
 		dialopts = append(dialopts, opt)
 	}
 
-	conn, err := grpc.Dial(name, dialopts...)
+	target, transportOpts, err := dmesh.DialOptions(name)
+	if err != nil {
+		return nil, err
+	}
+	dialopts = append(dialopts, transportOpts...)
+	conn, err := grpc.Dial(target, dialopts...)
 	if err != nil {
 		return nil, fmt.Errorf("failed to dial %s: %v", name, err)
 	}
 
+	if err := dmesh.TrackClient(conn); err != nil {
+		return nil, err
+	}
 	return conn, nil
 }
