diff -ruN a/src/python/grpcio/grpc/_cython/_cygrpc/server.pyx.pxi b/src/python/grpcio/grpc/_cython/_cygrpc/server.pyx.pxi
--- a/src/python/grpcio/grpc/_cython/_cygrpc/server.pyx.pxi	2026-03-25 08:15:03.000000000 +0900
+++ b/src/python/grpcio/grpc/_cython/_cygrpc/server.pyx.pxi	2026-09-29 21:29:56.727017392 +0900
@@ -45,6 +45,7 @@
     self.is_shutting_down = False
     self.is_shutdown = False
     self.c_server = NULL
+    self.dpumesh_listener = NULL
     self.registered_methods = {}  # Mapping[bytes, RegisteredMethod]
     cdef _ChannelArgs channel_args = _ChannelArgs(arguments)
     self.c_server = grpc_server_create(channel_args.c_args(), NULL)
@@ -186,7 +187,29 @@
           self.c_server, queue.c_completion_queue,
           <cpython.PyObject *>server_shutdown_tag)
 
+  # DPUMesh: add_dpumesh_listener() before start(), serve_dpumesh() after it;
+  # the server then takes the streams the DPU routes to DPUMESH_SERVICE.
+  def add_dpumesh_listener(self):
+    cdef char err[256]
+    err[0] = 0
+    if self.is_started:
+      raise ValueError('the DPUMesh listener must be added before start')
+    self.dpumesh_listener = dpumesh_server_add_listener(
+        self.c_server, err, sizeof(err))
+    if self.dpumesh_listener == NULL:
+      raise RuntimeError('DPUMesh listener: ' + (<bytes>err).decode())
+
+  def serve_dpumesh(self):
+    cdef char err[256]
+    err[0] = 0
+    if self.dpumesh_listener == NULL or not self.is_started:
+      raise ValueError('serve_dpumesh follows add_dpumesh_listener and start')
+    if dpumesh_server_serve(self.dpumesh_listener, err, sizeof(err)) != 0:
+      raise RuntimeError('DPUMesh listener: ' + (<bytes>err).decode())
+
   def shutdown(self, CompletionQueue queue not None, tag):
+    if self.dpumesh_listener != NULL:
+      dpumesh_server_stop(self.dpumesh_listener)
     if queue.is_shutting_down:
       raise ValueError("queue must be live")
     elif not self.is_started:
@@ -242,3 +265,9 @@
   def __dealloc__(self):
     if self.c_server == NULL:
       grpc_shutdown()
+
+
+def close_dpumesh():
+  """DPUMesh: closes the process's DPUMesh runtime before it exits."""
+  with nogil:
+    dpumesh_close()
