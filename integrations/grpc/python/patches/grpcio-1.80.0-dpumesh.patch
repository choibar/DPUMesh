+    os.path.join("dpumesh", "dpumesh_grpcio.cc"),
+    os.path.join("dpumesh", "dmesh_endpoint.cc"),
+)
+DPUMESH_INCLUDE = ("dpumesh",)
+
 EXTENSION_INCLUDE_DIRECTORIES = (
     (PYTHON_STEM,)
