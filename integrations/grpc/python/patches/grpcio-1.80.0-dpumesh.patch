diff -ruN a/src/python/grpcio/grpc/_cython/_cygrpc/channel.pyx.pxi b/src/python/grpcio/grpc/_cython/_cygrpc/channel.pyx.pxi
--- a/src/python/grpcio/grpc/_cython/_cygrpc/channel.pyx.pxi	2026-03-25 08:15:03.000000000 +0900
+++ b/src/python/grpcio/grpc/_cython/_cygrpc/channel.pyx.pxi	2026-09-29 21:29:56.715017503 +0900
@@ -505,10 +505,21 @@
     c_channel_credentials = (
         channel_credentials.c() if channel_credentials is not None
         else grpc_insecure_credentials_create())
-    self._state.c_channel = grpc_channel_create(
-        <char *>target, c_channel_credentials, channel_args.c_args())
+    # DPUMesh: a "dpumesh:<host>:<port>" target reaches the service over
+    # DPUMesh streams.
+    cdef char dpumesh_error[256]
+    dpumesh_error[0] = 0
+    if target.startswith(b'dpumesh:'):
+      self._state.c_channel = dpumesh_channel_create(
+          (<char *>target) + 8, c_channel_credentials, channel_args.c_args(),
+          dpumesh_error, sizeof(dpumesh_error))
+    else:
+      self._state.c_channel = grpc_channel_create(
+          <char *>target, c_channel_credentials, channel_args.c_args())
     self._registered_call_handles = {}
     grpc_channel_credentials_release(c_channel_credentials)
+    if self._state.c_channel == NULL:
+      raise ValueError('DPUMesh channel: ' + (<bytes>dpumesh_error).decode())
 
   def target(self):
     cdef char *c_target
