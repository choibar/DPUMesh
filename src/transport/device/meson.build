dpa_program_lib = custom_target('dpa_kernel',
  input : ['dpa_kernel.c', 'benchmarks/dpa_bench.c',
           '../peer/device/peer_runtime.c', '../peer/device/peer_dpa_rdma.c',
           '../peer/device/peer_write_sync_dpa.c'],
  output : 'dpa_kernel.a',
  depend_files : files('../common/dpa_common.h', 'hpack_walk.h', 'huff_fsm.h',
                       '../common/dpa_bench.h', 'benchmarks/hpack_term.h', 'benchmarks/dsb_blocks.h',
                       '../peer/peer_dpa_abi.h', '../peer/peer_dpa_ring.h',
                       '../peer/peer_rdma_limits.h', '../peer/peer_dpa_work.h', '../peer/peer_data_wire.h',
                       '../peer/peer_write_sync_dpa_shared.h', '../peer/peer_write_imm_counter.h',
                       '../peer/peer_write_fence_stats.h', '../peer/peer_write_bootstrap.h',
                       '../peer/device/peer_dpa_rdma.h', '../peer/device/peer_dpa_cq.h',
                       '../peer/device/peer_dpa_notify.h', '../peer/device/peer_dpa_profile.h',
                       '../peer/peer_dpa_profile.h', '../peer/device/peer_write_sync_dpa_cq.h'),
  command : [dpacc_build_script, meson.project_build_root(), meson.project_source_root(),
             '@INPUT0@', program_name, dpacc_mcpu_flag, doca_lib_dir,
             '@INPUT1@', '@INPUT2@', '@INPUT3@', '@INPUT4@'],
  build_by_default : true,
)
